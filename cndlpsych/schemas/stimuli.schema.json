{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/cndlpsych/1/stimuli.schema.json",
  "title": "stimuli.yaml",
  "description": "Named, typed stimuli that timelines refer to. Built-in types: html, text, image, audio, shape, fill, blank. Any other 'type' names a custom generator in custom/stimuli/<type>.js and takes 'params'. Text fields may use {{intent.hint}} and {{param}} variables. 'each' expands one entry into many, substituting {value} and {index} in name and content.\n",
  "type": "object",
  "required": [
    "stimuli"
  ],
  "additionalProperties": false,
  "properties": {
    "styles": {
      "description": "Named style sets (CSS properties) referenced from 'style'.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/definitions/ident"
      },
      "additionalProperties": {
        "$ref": "#/definitions/css_props"
      }
    },
    "stimuli": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/stimulus"
      }
    }
  },
  "definitions": {
    "css_props": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "size": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "CSS px"
        },
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?(px|rem|em|vh|vw|mm|deg|%)$"
        }
      ]
    },
    "stimulus": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Id, or a template containing {value} / {index} when 'each' is used.",
          "type": "string",
          "pattern": "^[\\p{L}_{][\\p{L}\\p{N}_.{}-]*$",
          "maxLength": 64
        },
        "type": {
          "description": "Built in: html, text, image, audio, shape, fill, blank. Any other value names a custom generator in custom/stimuli/<type>.js.",
          "type": "string",
          "allOf": [
            {
              "$ref": "common.schema.json#/definitions/id"
            }
          ]
        },
        "each": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "trigger": {
          "description": "Sugar for a lowest-scope trigger rule on this stimulus's onset (id stim:<name>).",
          "type": "integer",
          "minimum": 0
        },
        "trigger_base": {
          "description": "With 'each' - trigger = base + index.",
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "description": "How long it stays; null = until a response ends the phase.",
          "$ref": "common.schema.json#/definitions/duration_or_null"
        },
        "post": {
          "description": "Gap after the stimulus (a [min, max] pair jitters).",
          "$ref": "common.schema.json#/definitions/duration"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/ident"
            },
            {
              "$ref": "#/definitions/css_props"
            }
          ]
        },
        "class": {
          "type": "string"
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "$ref": "common.schema.json#/definitions/unit_interval"
            },
            "y": {
              "$ref": "common.schema.json#/definitions/unit_interval"
            }
          }
        },
        "html": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "size": {
          "$ref": "#/definitions/size"
        },
        "color": {
          "type": "string"
        },
        "font": {
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "enum": [
                "normal",
                "bold"
              ]
            },
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            }
          ]
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "shape": {
          "enum": [
            "circle",
            "square",
            "rect",
            "cross"
          ]
        },
        "cover": {
          "description": "For type fill - cover the stage or the whole viewport (overlays stay on top).",
          "enum": [
            "stage",
            "viewport"
          ],
          "default": "viewport"
        },
        "params": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "html"
              }
            }
          },
          "then": {
            "required": [
              "html"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "image",
                  "audio"
                ]
              }
            }
          },
          "then": {
            "required": [
              "src"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "shape"
              }
            }
          },
          "then": {
            "required": [
              "shape"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "fill"
              }
            }
          },
          "then": {
            "required": [
              "color"
            ]
          }
        },
        {
          "if": {
            "required": [
              "trigger_base"
            ]
          },
          "then": {
            "required": [
              "each"
            ]
          }
        },
        {
          "not": {
            "required": [
              "trigger",
              "trigger_base"
            ]
          }
        }
      ]
    }
  }
}
