rules_version = '2';

// GENERATED by tools/gen_rules.py (access: controlled) - edit the generator, not this file.
// Layout: see firebase/DESIGN.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    // Experimenters sign in (e.g. Google) and are listed in experiments/{exp}/admins/{email}.
    function isAdmin(exp) {
      return authed()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/experiments/$(exp)/admins/$(request.auth.token.email));
    }

    function claimPath(exp, n) {
      return /databases/$(database)/documents/experiments/$(exp)/claims/$(string(n));
    }

    function markerPath(exp, uid) {
      return /databases/$(database)/documents/experiments/$(exp)/claims_by_uid/$(uid);
    }

    function sessionPath(exp, uid, key) {
      return /databases/$(database)/documents/experiments/$(exp)/data/$(uid)/sessions/$(key);
    }

    // ---- shape checks ----------------------------------------------------------

    function validClaim(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['n', 'label', 'status', 'created_at'])
        && d.keys().hasAll(['n', 'label', 'status', 'created_at'])
        && d.n is int && d.n >= 1
        && id == string(d.n)
        && d.label is string && d.label.matches('^sub-[0-9]+$')
        && d.status == 'reserved'
        && d.created_at == request.time;
    }

    function validTransition(from, to) {
      return (from == 'reserved' && to == 'active')
        || (from == 'active' && to in ['complete', 'void']);
    }

    function validSession(exp, uid, key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['clock', 'consent', 'device', 'end_reason', 'ended_at', 'experiment', 'experiment_id', 'eyetracking', 'last_seq', 'n_chunks', 'overlays', 'schema_version', 'session_fields', 'session_id', 'sinks', 'stage', 'started_at', 'status', 'subject', 'subject_id', 'uid', 'url_params'])
        && d.keys().hasAll(['schema_version', 'subject_id', 'session_id', 'status', 'started_at', 'experiment', 'consent', 'device', 'clock', 'stage', 'uid', 'experiment_id'])
        && d.uid == uid
        && d.experiment_id == exp
        && d.status == 'in_progress'
        && d.subject_id is string && d.subject_id.matches('^sub-[A-Za-z0-9]+$')
        && d.session_id is string && d.session_id.matches('^ses-[A-Za-z0-9]+$')
        && key == d.subject_id + '_' + d.session_id;
    }

    // After creation only end-of-session bookkeeping may change, and only once.
    function sessionUpdateOk() {
      let d = request.resource.data;
      return resource.data.status == 'in_progress'
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'ended_at', 'end_reason', 'eyetracking', 'sinks', 'n_chunks', 'last_seq'])
        && d.status in ['in_progress', 'complete', 'aborted', 'error', 'device_rejected'];
    }

    function validChunk(i) {
      let d = request.resource.data;
      return d.keys().hasOnly(['i', 'n_events', 'from_seq', 'to_seq', 't_first', 't_last', 'encoding', 'payload'])
        && d.keys().hasAll(['i', 'n_events', 'from_seq', 'to_seq', 't_first', 't_last', 'encoding', 'payload'])
        && d.i is int && d.i >= 0 && i == string(d.i)
        && d.n_events is int && d.n_events >= 1 && d.n_events <= 5000
        && d.from_seq is int && d.to_seq is int && d.from_seq <= d.to_seq
        && d.encoding in ['json', 'gzip-base64']
        && d.payload is string && d.payload.size() <= 900000;
    }

    // ---- controlled mode: only signed-in, allow-listed experimenters write -------

    match /experiments/{exp} {
      allow read, write: if false;            // managed with the Admin SDK / console

      match /admins/{email} {
        allow read: if isAdmin(exp);
        allow write: if false;
      }

      match /claims/{id} {
        allow get, list: if isAdmin(exp);
        allow create: if isAdmin(exp) && validClaim(id);     // any free number (override allowed)
        allow update: if isAdmin(exp)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isAdmin(exp);
      }

      match /data/{uid}/sessions/{key} {
        allow read: if isAdmin(exp);
        allow create: if isAdmin(exp) && request.auth.uid == uid && validSession(exp, uid, key);
        allow update: if isAdmin(exp) && request.auth.uid == uid && sessionUpdateOk();

        match /chunks/{i} {
          allow read: if isAdmin(exp);
          allow create: if isAdmin(exp) && request.auth.uid == uid && validChunk(i)
            && exists(sessionPath(exp, uid, key));
          allow update: if isAdmin(exp) && request.auth.uid == uid
            && request.resource.data == resource.data;
        }
      }

    }

    // Collection-group reads let experimenter tooling find a subject's sessions
    // (needs the field overrides in firestore.indexes.json).
    match /{path=**}/sessions/{key} {
      allow read: if isAdmin(resource.data.experiment_id);
    }
  }
}
