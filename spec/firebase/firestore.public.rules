rules_version = '2';

// GENERATED by tools/gen_rules.js (access: public) - edit the generator, not this file.
// Layout: see firebase/DESIGN.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    // Experimenters sign in (e.g. Google) and are listed in experiments/{exp}/admins/{email}.
    function isAdmin(exp) {
      return authed()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/experiments/$(exp)/admins/$(request.auth.token.email));
    }

    function claimPath(exp, n) {
      return /databases/$(database)/documents/experiments/$(exp)/claims/$(string(n));
    }

    function markerPath(exp, uid) {
      return /databases/$(database)/documents/experiments/$(exp)/claims_by_uid/$(uid);
    }

    function sessionPath(exp, uid, key) {
      return /databases/$(database)/documents/experiments/$(exp)/data/$(uid)/sessions/$(key);
    }

    // ---- shape checks ----------------------------------------------------------

    function validClaim(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['n', 'label', 'status', 'created_at'])
        && d.keys().hasAll(['n', 'label', 'status', 'created_at'])
        && d.n is int && d.n >= 1
        && id == string(d.n)
        && d.label is string && d.label.matches('^sub-[0-9]+$')
        && d.status == 'reserved'
        && d.created_at == request.time;
    }

    function validTransition(from, to) {
      return (from == 'reserved' && to == 'active')
        || (from == 'active' && to in ['complete', 'void']);
    }

    function validSession(exp, uid, key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['clock', 'consent', 'device', 'end_reason', 'ended_at', 'experiment', 'experiment_id', 'eyetracking', 'last_seq', 'mode', 'n_chunks', 'overlays', 'resumes', 'schema_version', 'session_fields', 'session_id', 'sinks', 'stage', 'started_at', 'status', 'subject', 'subject_id', 'uid', 'url_params', 'webcam'])
        && d.keys().hasAll(['schema_version', 'subject_id', 'session_id', 'status', 'started_at', 'experiment', 'consent', 'device', 'clock', 'stage', 'uid', 'experiment_id'])
        && d.uid == uid
        && d.experiment_id == exp
        && d.status == 'in_progress'
        && d.subject_id is string && d.subject_id.matches('^sub-[A-Za-z0-9]+$')
        && d.session_id is string && d.session_id.matches('^ses-[A-Za-z0-9]+$')
        && key == d.subject_id + '_' + d.session_id;
    }

    // After creation only end-of-session bookkeeping may change, and only once.
    function sessionUpdateOk() {
      let d = request.resource.data;
      return resource.data.status == 'in_progress'
        && d.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'ended_at', 'end_reason', 'eyetracking', 'sinks', 'n_chunks', 'last_seq'])
        && d.status in ['in_progress', 'complete', 'aborted', 'error', 'device_rejected'];
    }

    function validChunk(i) {
      let d = request.resource.data;
      return d.keys().hasOnly(['i', 'n_events', 'from_seq', 'to_seq', 't_first', 't_last', 'encoding', 'payload'])
        && d.keys().hasAll(['i', 'n_events', 'from_seq', 'to_seq', 't_first', 't_last', 'encoding', 'payload'])
        && d.i is int && d.i >= 0 && i == string(d.i)
        && d.n_events is int && d.n_events >= 1 && d.n_events <= 5000
        && d.from_seq is int && d.to_seq is int && d.from_seq <= d.to_seq
        && d.encoding in ['json', 'gzip-base64']
        && d.payload is string && d.payload.size() <= 900000;
    }

    // ---- public mode: anonymous participants, one subject number per user ------

    function ownsClaim(exp, n) {
      return get(markerPath(exp, request.auth.uid)).data.n == n;
    }

    // Contiguity: n may only be created if n-1 exists, so numbers are never skipped.
    // The marker (one per anonymous uid) must be created in the same batch.
    function publicClaimOk(exp) {
      let n = request.resource.data.n;
      return (n == 1 || exists(claimPath(exp, n - 1)))
        && existsAfter(markerPath(exp, request.auth.uid))
        && getAfter(markerPath(exp, request.auth.uid)).data.n == n;
    }

    // The session must belong to the subject number this uid claimed.
    function publicSessionOk(exp, uid) {
      return get(claimPath(exp, get(markerPath(exp, uid)).data.n)).data.label
             == request.resource.data.subject_id;
    }

    match /experiments/{exp} {
      allow read, write: if false;            // managed with the Admin SDK / console

      match /admins/{email} {
        allow read: if isAdmin(exp);
        allow write: if false;
      }

      match /claims/{id} {
        allow get: if authed();                 // existence probing for the allocator
        allow list: if isAdmin(exp);
        allow create: if authed() && validClaim(id)
          && (isAdmin(exp) || publicClaimOk(exp));
        allow update: if authed()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (isAdmin(exp)
              || (ownsClaim(exp, resource.data.n)
                  && validTransition(resource.data.status, request.resource.data.status)));
        allow delete: if isAdmin(exp);
      }

      match /claims_by_uid/{uid} {
        allow get: if authed() && (request.auth.uid == uid || isAdmin(exp));
        allow list: if isAdmin(exp);
        allow create: if authed() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['n', 'created_at'])
          && request.resource.data.keys().hasAll(['n', 'created_at'])
          && request.resource.data.n is int
          && request.resource.data.created_at == request.time
          && existsAfter(claimPath(exp, request.resource.data.n))
          && getAfter(claimPath(exp, request.resource.data.n)).data.n == request.resource.data.n;
        allow update: if false;
        allow delete: if isAdmin(exp);
      }

      // Participants can write their own data but never read any of it back.
      match /data/{uid}/sessions/{key} {
        allow read: if isAdmin(exp);
        allow create: if authed() && request.auth.uid == uid
          && validSession(exp, uid, key) && publicSessionOk(exp, uid);
        allow update: if (authed() && request.auth.uid == uid && sessionUpdateOk())
          || isAdmin(exp);

        match /chunks/{i} {
          allow read: if isAdmin(exp);
          allow create: if authed() && request.auth.uid == uid && validChunk(i)
            && exists(sessionPath(exp, uid, key));
          allow update: if authed() && request.auth.uid == uid        // idempotent retry only
            && request.resource.data == resource.data;
        }
      }

    }

    // Collection-group reads let experimenter tooling find a subject's sessions
    // (needs the field overrides in firestore.indexes.json).
    match /{path=**}/sessions/{key} {
      allow read: if isAdmin(resource.data.experiment_id);
    }
  }
}
