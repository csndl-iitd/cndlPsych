rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // An admin is anyone who is logged in with an actual account (not anonymous)
    function isAdmin() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isOwner() { return request.auth != null && resource.data.uid == request.auth.uid; }
    function isSettingOwnership() { return request.auth != null && request.resource.data.uid == request.auth.uid; }

    // Global Admin Rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Secure Counter for Anonymous Subjects (Increment by 1 only)
    match /metadata/counter {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.lastId == 1;
      allow update: if request.auth != null && request.resource.data.lastId == resource.data.lastId + 1;
    }

    // Participant Rules
    match /participants/{docId} {
      allow create: if isSettingOwnership();
      allow read, update, delete: if isOwner();
    }
    match /sessions/{docId} {
      allow create: if isSettingOwnership();
      allow read, update, delete: if isOwner();
    }
    match /experiment_events/{docId} {
      allow create: if isSettingOwnership();
      allow read, update, delete: if isOwner();
    }
    match /trials/{docId} {
      allow create: if isSettingOwnership();
      allow read, update, delete: if isOwner();
    }
  }
}