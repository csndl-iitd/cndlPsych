{
  "name": "cndlpsych",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser experiment framework (placeholder name)",
  "scripts": {
    "build:schemas": "node spec/tools/build.js",
    "build:rules": "node spec/tools/gen_rules.js",
    "check:schemas": "node spec/tools/build.js --check && node spec/tools/gen_rules.js --check && node tools/build-docs.js --check",
    "lint": "eslint .",
    "validate": "node cli/validate.js",
    "export-firestore": "node cli/export-firestore.js",
    "play": "node tools/build-e2e.js && node tools/static-server.js",
    "check:layers": "node tools/check-layers.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:emulator": "vitest run -c vitest.emulator.config.js",
    "ci": "npm run check:schemas && npm run lint && npm run check:layers && npm run typecheck && npm test",
    "build": "node tools/build-dist.js",
    "cndlpsych": "node cli/cndlpsych.js",
    "build:docs": "node tools/build-docs.js",
    "timing": "node tools/timing/measure.js --write docs/timing.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@jspsych/plugin-html-keyboard-response": "^2.2.0",
    "@jspsych/plugin-survey": "^4.0.0",
    "ajv": "^8.20.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "js-yaml": "^4.3.2",
    "jspsych": "^8.3.0",
    "webgazer": "^3.5.3"
  },
  "bin": {
    "cndlpsych": "cli/cndlpsych.js"
  },
  "license": "MIT"
}
