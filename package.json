{
  "name": "expfw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser experiment framework (placeholder name)",
  "scripts": {
    "build:schemas": "node spec/tools/build.js",
    "check:schemas": "node spec/tools/build.js --check",
    "lint": "eslint .",
    "validate": "node cli/validate.js",
    "play": "node tools/build-e2e.js && node tools/static-server.js",
    "check:layers": "node tools/check-layers.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "ci": "npm run check:schemas && npm run lint && npm run check:layers && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@jspsych/plugin-html-keyboard-response": "^2.2.0",
    "@jspsych/plugin-survey": "^4.0.0",
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.2",
    "jspsych": "^8.3.0"
  }
}
