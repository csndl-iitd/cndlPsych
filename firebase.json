{
  "hosting": {
    "site": "cndlsearch",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firebase/**",
      "package.json",
      "package-lock.json",
      "cndlpsych/cli/**",
      "cndlpsych/firebase/**",
      "cndlpsych/package.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.LEGAL.txt"
    ],
    "headers": [
      {
        "source": "**/*.@(js|yaml|json|md)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
